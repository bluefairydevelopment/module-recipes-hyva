                    </div>

                    <!-- Summary -->
                    <div class="mb-4">
                        <label for="review-summary" class="mb-1 block text-sm font-medium text-gray-700">
                            <?= $escaper->escapeHtml(__('Summary')) ?>
                        </label>
                        <input
                            type="text"
                            id="review-summary"
                            name="summary"
                            class="block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
                            x-model="summary"
                            maxlength="255"
