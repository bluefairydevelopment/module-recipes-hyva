                    </div>

                    <!-- Review Text -->
                    <div class="mb-4">
                        <label for="review-text" class="mb-1 block text-sm font-medium text-gray-700">
                            <?= $escaper->escapeHtml(__('Review')) ?>
                            <span class="text-red-500" aria-hidden="true">*</span>
                        </label>
                        <textarea
