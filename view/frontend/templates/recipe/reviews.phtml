<?php declare(strict_types=1);/**
 * Copyright © 2025 Blue Fairy Development. All rights reserved.
 *
 * Hyva reviews template — Alpine reviewForm component.
 * Client-side validation and AJAX submission with Hyva notification pattern.
 *
 * @var \BlueFairy\Recipes\Block\Recipe\View $block
 * @var \Magento\Framework\Escaper $escaper
 */

$recipe    = $block->getRecipe();
$reviews   = $block->getApprovedReviews();
$submitUrl = $block->getReviewSubmitUrl();

?>
<?php /* The component itself is only needed when the form is rendered. */ ?>
<?php if ($recipe && $block->canReview()): ?>
<script>
function blueRecipeReview() {
    return {
        submitUrl: <?= /* @noEscape */ json_encode($submitUrl, JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_AMP | JSON_HEX_QUOT) ?>,
        formKey: '',
        recipeId: <?= /* @noEscape */ json_encode((int) $recipe->getRecipeId(), JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_AMP | JSON_HEX_QUOT) ?>,
        nickname: '',
        rating: 0,
        summary: '',
        reviewText: '',
        loading: false,
        submitted: false,
        errors: {},
        init() {
            this.formKey = document.querySelector('input[name="form_key"]')?.value
                || document.cookie.match(/(?:^|;\s*)form_key=([^;]+)/)?.[1]
                || '';
        },
        validate() {
            this.errors = {};
            if (!this.nickname.trim()) this.errors.nickname = '<?= $escaper->escapeJs(__('Nickname is required.')) ?>';
            if (!this.rating) this.errors.rating = '<?= $escaper->escapeJs(__('Please select a rating.')) ?>';
            if (!this.reviewText.trim()) this.errors.reviewText = '<?= $escaper->escapeJs(__('Review text is required.')) ?>';
            return Object.keys(this.errors).length === 0;
        },
        async submitReview() {
            if (!this.validate()) return;
            this.loading = true;
            try {
                const body = new URLSearchParams({
                    form_key: this.formKey,
                    recipe_id: this.recipeId,
                    nickname: this.nickname,
                    rating: this.rating,
                    summary: this.summary,
                    review_text: this.reviewText
                });
                const resp = await fetch(this.submitUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
                    body: body.toString()
                });
                const data = await resp.json();
                if (data.success) {
                    this.submitted = true;
                    window.dispatchEvent(new CustomEvent('notification', {
                        detail: { message: data.message || '<?= $escaper->escapeJs(__('Thank you for your review!')) ?>', type: 'success', timeout: 5000 }
                    }));
                } else {
                    window.dispatchEvent(new CustomEvent('notification', {
                        detail: { message: data.message || '<?= $escaper->escapeJs(__('Could not submit review.')) ?>', type: 'error', timeout: 5000 }
                    }));
                }
            } catch (e) {
                window.dispatchEvent(new CustomEvent('notification', {
                    detail: { message: '<?= $escaper->escapeJs(__('An error occurred. Please try again.')) ?>', type: 'error', timeout: 5000 }
                }));
            } finally {
                this.loading = false;
            }
        }
    };
}
</script>
<?php endif; ?>
<div class="rounded-2xl border border-gray-100 bg-white p-6 shadow-sm">
    <h2 class="mb-6 text-xl font-bold text-gray-900">
        <?= $escaper->escapeHtml(__('Reviews')) ?>
    </h2>

    <!-- Existing Reviews -->
    <?php if ($reviews->getSize() > 0): ?>
        <div class="mb-8 space-y-4">
            <?php foreach ($reviews as $review): ?>
                <div class="rounded-xl border border-gray-100 bg-gray-50 p-4">
                    <div class="mb-2 flex flex-wrap items-center gap-2">
                        <span class="font-semibold text-gray-900">
                            <?= $escaper->escapeHtml($review->getNickname()) ?>
                        </span>
                        <?php if ($review->getRating()): ?>
                            <span class="flex" aria-label="<?= $escaper->escapeHtmlAttr(__('%1 out of 5', $review->getRating())) ?>">
                                <?php for ($i = 1; $i <= 5; $i++): ?>
                                    <svg class="h-4 w-4 <?= $i <= (int) $review->getRating() ? 'text-yellow-400' : 'text-gray-200' ?>"
                                         fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                                    </svg>
                                <?php endfor; ?>
                            </span>
                        <?php endif; ?>
                        <span class="ml-auto text-xs text-gray-400">
                            <?= $escaper->escapeHtml($review->getCreatedAt()) ?>
                        </span>
                    </div>
                    <?php if ($review->getSummary()): ?>
                        <h4 class="mb-1 font-medium text-gray-800">
                            <?= $escaper->escapeHtml($review->getSummary()) ?>
