            <?php endforeach; ?>
        </div>
    <?php else: ?>
        <p class="mb-8 text-sm text-gray-500 italic">
            <?= $escaper->escapeHtml(__('No reviews yet. Be the first to review this recipe!')) ?>
        </p>
    <?php endif; ?>

    <!-- Review submission form, gated on canReview(). allow_guest_reviews defaults to 0
         and the controller enforces it, so a guest is shown the sign-in prompt instead of
         a form whose submission would be refused. -->
    <?php if ($recipe && !$block->canReview()): ?>
        <div class="rounded-xl bg-gray-50 p-4 text-sm text-gray-700">
            <p class="mb-3"><?= $escaper->escapeHtml(__('Please sign in to write a review.')) ?></p>
            <a href="<?= $escaper->escapeUrl($block->getLoginUrl()) ?>"
               class="inline-flex items-center rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700">
                <?= $escaper->escapeHtml(__('Sign In')) ?>
            </a>
        </div>
    <?php endif; ?>

    <?php if ($recipe && $block->canReview()): ?>
        <div x-data="blueRecipeReview()">
            <template x-if="submitted">
                <div class="rounded-xl bg-green-50 p-4 text-sm text-green-800">
                    <?= $escaper->escapeHtml(__('Thank you! Your review has been submitted and is pending approval.')) ?>
                </div>
            </template>

            <template x-if="!submitted">
                <div>
                    <h3 class="mb-4 text-base font-semibold text-gray-900">
                        <?= $escaper->escapeHtml(__('Write a Review')) ?>
                    </h3>

                    <!-- Nickname -->
                    <div class="mb-4">
