                            maxlength="100"
                            required
                            aria-required="true"
                            :aria-describedby="errors.nickname ? 'review-nickname-error' : undefined"
                        />
                        <p x-show="errors.nickname"
                           x-text="errors.nickname"
                           id="review-nickname-error"
                           class="mt-1 text-xs text-red-500"
                           role="alert"></p>
                    </div>

                    <!-- Rating -->
                    <div class="mb-4">
                        <span class="mb-1 block text-sm font-medium text-gray-700" id="rating-label">
                            <?= $escaper->escapeHtml(__('Rating')) ?>
                            <span class="text-red-500" aria-hidden="true">*</span>
                        </span>
                        <div class="flex gap-1"
                             role="radiogroup"
                             aria-labelledby="rating-label"
                             aria-required="true">
                            <?php for ($i = 1; $i <= 5; $i++): ?>
                                <button
                                    type="button"
