$recipes   = $block->getRecipeCollection();
$filters   = $block->getActiveFilters();
$formUrl   = $block->getFilterFormUrl();
$keyword   = $block->getSearchKeyword();
$searchUrl = $block->getUrl('recipes/ajax/search');

$filterParams = $block->getCurrentFilterParams();

// Build initial selected filters map for Alpine
$selectedFilters = [];
foreach ($filters as $filter) {
    $selectedId = $block->getSelectedOptionId($filter->getFilterCode());
    $selectedFilters[$filter->getFilterCode()] = $selectedId !== 0 ? $selectedId : '';
}
?>
<script>
function blueRecipeList() {
    return {
        formUrl: <?= /* @noEscape */ json_encode($formUrl, JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_AMP | JSON_HEX_QUOT) ?>,
        searchUrl: <?= /* @noEscape */ json_encode($searchUrl, JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_AMP | JSON_HEX_QUOT) ?>,
        keyword: <?= /* @noEscape */ json_encode($keyword, JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_AMP | JSON_HEX_QUOT) ?>,
        filters: <?= /* @noEscape */ json_encode($selectedFilters, JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_AMP | JSON_HEX_QUOT) ?>,
        searchTimeout: null,
        filterTimeout: null,
        loading: false,
        hasFilters() {
            if (this.keyword.trim() !== '') return true;
            return Object.values(this.filters).some(v => v !== '' && v !== null);
        },
        clearAll() {
            this.keyword = '';
            Object.keys(this.filters).forEach(k => { this.filters[k] = ''; });
            window.location.href = this.formUrl;
        },
        submitSearch() {
            const url = new URL(this.formUrl, window.location.origin);
            if (this.keyword.trim()) url.searchParams.set('q', this.keyword.trim());
            Object.entries(this.filters).forEach(([code, val]) => {
                if (val !== '' && val !== null) url.searchParams.set('filter_' + code, val);
            });
            window.location.href = url.toString();
        },
        onFilterChange() {
            clearTimeout(this.filterTimeout);
            this.filterTimeout = setTimeout(() => { this.submitSearch(); }, 250);
        },
        onSearchInput() {
            clearTimeout(this.searchTimeout);
            this.searchTimeout = setTimeout(() => { this.submitSearch(); }, 600);
        }
    };
}
</script>
<section class="blue-recipe-list py-8" x-data="blueRecipeList()">
