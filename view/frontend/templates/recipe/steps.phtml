$steps = $block->getSteps();

if (!$steps->getSize()) {
    return;
}
?>
<div class="blue-recipe-steps py-6">
    <h2 class="mb-4 text-2xl font-bold text-gray-900"><?= $escaper->escapeHtml(__('Method')) ?></h2>
    <ol class="space-y-4">
        <?php $stepNumber = 0; ?>
        <?php foreach ($steps as $step): ?>
            <?php $stepNumber++; ?>
            <li class="flex gap-4">
                <span class="flex-shrink-0 flex h-7 w-7 items-center justify-center rounded-full bg-blue-100 text-sm font-bold text-blue-700"
                      aria-hidden="true">
                    <?= (int) $stepNumber ?>
                </span>
                <p class="mt-0.5 leading-relaxed text-gray-700">
                    <?= $escaper->escapeHtml($step->getDescription()) ?>
                </p>
            </li>
        <?php endforeach; ?>
    </ol>
</div>
