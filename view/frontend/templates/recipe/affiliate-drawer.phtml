                </svg>
            </button>
        </div>

        <!-- Ingredient List -->
        <ul class="flex-1 overflow-y-auto divide-y divide-gray-100 px-4 py-2">
            <?php foreach ($affiliateIngredients as $ingredient): ?>
                <li class="flex items-center gap-3 py-3">
                    <div class="flex-1 min-w-0">
                        <?php if ($ingredient->getMeasure()): ?>
                            <span class="mr-1 font-semibold text-sm text-gray-900">
