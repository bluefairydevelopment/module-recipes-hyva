use BlueFairy\Recipes\Api\Data\IngredientInterface;

$ingredients = $block->getIngredients();
$affiliateIngredients = [];

foreach ($ingredients as $ingredient) {
    if ($ingredient->getType() === IngredientInterface::TYPE_AFFILIATE && $ingredient->getAffiliateUrl()) {
        $affiliateIngredients[] = $ingredient;
    }
}

if (empty($affiliateIngredients)) {
    return;
}
?>
<div
    class="fixed inset-0 z-50"
    x-data="{
        open: false,
        init() {
            const handler = () => {
                this.open = true;
                this.$nextTick(() => { this.$refs.closeBtn?.focus(); });
            };
            window.addEventListener('open-affiliate-drawer', handler);
            this.$cleanup(() => window.removeEventListener('open-affiliate-drawer', handler));
        },
        close() { this.open = false; }
    }"
    x-show="open"
    x-cloak
    @keydown.escape.window="close()"
    role="dialog"
    aria-modal="true"
    aria-labelledby="affiliate-drawer-title"
>
