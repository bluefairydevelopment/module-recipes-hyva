<script>
function blueRecipeSubmit() {
    return {
        ingredients: [],
        steps: [],
        addIngredient() {
            this.ingredients.push({ measure: '', label: '', type: '', url: '' });
        },
        removeIngredient(index) {
            this.ingredients.splice(index, 1);
        },
        addStep() {
            this.steps.push({ instruction: '' });
        },
        removeStep(index) {
            this.steps.splice(index, 1);
        },
        ingredientsJson() {
            return JSON.stringify(this.ingredients.map(i => ({
                measure: i.measure,
                label:   i.label,
                type:    i.type,
                url:     i.url
            })));
        },
        stepsJson() {
            return JSON.stringify(this.steps.map((s, i) => ({
                sort_order:  i + 1,
                instruction: s.instruction
            })));
        }
    };
}
</script>

