                                    <span>&#128338; <?= $escaper->escapeHtml(__('Cook: %1 min', $recipe->getCookTime())) ?></span>
                                <?php endif; ?>
                                <?php if ($recipe->getServingsMin()): ?>
                                    <span>&#127859; <?= $escaper->escapeHtml(__('Serves: %1', $recipe->getServingsMin())) ?></span>
                                <?php endif; ?>
                            </div>
